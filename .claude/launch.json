{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "podcast-dev",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-lc", "ulimit -n 10240; npm --prefix page run dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "podcast-static",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "-l", "4300", "page/.output/public"],
      "port": 4300,
      "autoPort": true
    }
  ]
}
